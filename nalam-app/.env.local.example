# Resend (https://resend.com) API key used to send requirements-form notifications.
RESEND_API_KEY=

# Email address that receives new requirements-form submissions.
# Defaults to the address in src/lib/constants.ts (siteConfig.contact.email) if unset.
CONTACT_NOTIFICATION_EMAIL=

# Verified "from" address for outgoing notification emails (must be a domain verified in Resend).
# Defaults to Resend's shared onboarding@resend.dev sender if unset (fine for testing, not for production).
CONTACT_FROM_EMAIL=
